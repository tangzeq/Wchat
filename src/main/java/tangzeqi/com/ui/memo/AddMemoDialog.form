        <border type="none" title="任务描述"/>
        <children>
          <component id="contentTextArea" class="javax.swing.JTextArea" binding="textContext">
            <constraints/>
            <properties>
              <lineWrap value="true"/>
              <maximumSize width="380" height="200"/>
              <minimumSize width="380" height="200"/>
              <opaque value="true"/>
              <preferredSize width="380" height="200"/>
              <rows value="5"/>
              <wrapStyleWord value="true"/>
            </properties>
          </component>
        </children>
      </scrollpane>
      <grid id="buttonPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="0" anchor="0" fill="2" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties>
          <preferredSize width="0" height="40"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="saveButton" class="javax.swing.JButton" binding="saveButton">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="保存"/>
            </properties>
          </component>
          <component id="cancelButton" class="javax.swing.JButton" binding="cancelButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="4" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="取消"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
