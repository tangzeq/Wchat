<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="tangzeqi.com.ui.memo.MemoPanel">
  <grid id="27dc6" binding="memoPanel" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="800" height="600"/>
    </constraints>
    <properties>
      <minimumSize width="600" height="400"/>
      <preferredSize width="800" height="600"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="topPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="searchField" class="javax.swing.JTextField" binding="searchField">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <toolTipText value="搜索任务..."/>
            </properties>
          </component>
          <component id="addButton" class="javax.swing.JButton" binding="addButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="+ 添加"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="bccd3" binding="scrollPane">
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="628" height="0"/>
          </grid>
        </constraints>
        <properties>
          <horizontalScrollBarPolicy value="HORIZONTAL_SCROLLBAR_NEVER"/>
          <verticalScrollBarPolicy value="VERTICAL_SCROLLBAR_AS_NEEDED"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="a0b5c" class="javax.swing.JPanel" binding="cards" custom-create="true">
            <constraints/>
            <properties/>
            <border type="none"/>
          </component>
        </children>
      </scrollpane>
      <grid id="bottomPanel" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="todoLabel" class="javax.swing.JLabel" binding="todoLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="待办任务：0"/>
            </properties>
          </component>
          <component id="completedLabel" class="javax.swing.JLabel" binding="completedLabel">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="今日完成：0/0"/>
            </properties>
          </component>
        </children>
      </grid>
    </children>
  </grid>
</form>
